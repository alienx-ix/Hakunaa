<?xml version="1.0" encoding="utf-8"?>
<!-- One Image Tools menu box (v0.1.169 redesign, user-approved mockup v40):
     lite blue card #F5F8FF + blue border #1E88E5, code-drawn gradient
     icon (ImageIconView, 48dp) + bold title + grey subtitle.
     Stretches to fill the screen (v0.1.122): the inner content is
     vertically centred, so tall cards still look balanced.
     v0.1.170: EXACT Video Tools card measurements (buildCard):
     corner radius 16dp, inner padding 6dp, title marginTop 6dp,
     subtitle 12sp, no font padding.
     v0.1.175: Image menu bg shade B #EFF8F4 (user picked from
     green-shades-menu.png, 2026-11-24 — a little lighter than
     the current phone #E0F2F1). Border stays teal #00BFA5.
     v0.1.174: PDF <-> Image UI colours interchanged
     (user 2026-11-24) — Image takes PDF's teal.
     Card #E0F2F1, stroke #00BFA5 2dp. Icons untouched.
     v0.1.171: cardElevation 0dp (Video card is flat, no shadow).
     v0.1.170: EXACT Video Tools card measurements (buildCard):
     corner radius 16dp, inner padding 6dp, title marginTop 6dp,
     subtitle 12sp, no font padding. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#EFF8F4"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#00BFA5"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <com.hakunaa.app.image.ImageIconView
            android:id="@+id/ivIcon"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/hakunaa_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/hakunaa_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
