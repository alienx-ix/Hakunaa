<?xml version="1.0" encoding="utf-8"?>
<!-- Image Tools menu (v0.1.122): box-by-box grid, importance order,
     professional look. The 5 rows SHARE the whole screen height
     (weight) — no ScrollView, no empty space at the bottom.
     Pick an image first, then tap a tool. No search bar, no
     status card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hakunaa_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hakunaa_surface"
        android:elevation="2dp"
        android:title="Image Tools"
        android:titleTextColor="@color/hakunaa_text"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <!-- Tool boxes, built in code (importance order). Rows stretch
         to fill the screen — see buildToolGrid().
         v0.1.170: EXACT Video Tools measurements (contentArea):
         16dp sides, 12dp top/bottom. -->
    <LinearLayout
        android:id="@+id/toolsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />
</LinearLayout>
