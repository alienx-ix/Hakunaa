<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-screen live camera preview — FIT_CENTER shows the
         whole camera frame, centred in a slightly shortened
         view. A 160dp bottom margin (v0.1.60) lifts the centred
         image up about 80dp: the top black bar shrinks to a
         little black (just the top bar with the menus), the way
         the user wants it, while the capture area still sits
         near the centre and there is no big empty gap above
         the Single button. (Centred with no margin left a lot
         of empty black at the top; FIT_START put the image at
         the very top with no black at all — both were wrong.)
         The edge/grid overlays carry the same bottom margin,
         so the frame and grid still sit exactly on the image. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="160dp"
        app:scaleType="fitCenter" />

    <!-- Dynamic document-edge overlay — draws the detected page's
         real corners, live, right where the page is in the
         preview. No fixed box: the frame follows the book and
         disappears when no document is found. -->
    <com.hakunaa.app.scanner.EdgeOverlayView
        android:id="@+id/edgeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="160dp" />

    <!-- Rule-of-thirds grid — the framing aid, toggled from
         the Grid button on the bottom row. Off by default. -->
    <com.hakunaa.app.scanner.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="160dp"
        android:visibility="gone" />

    <!-- Tap-to-focus ring — appears at the tap point, fades.
         Positioned in code, centred on the tap. -->
    <ImageView
        android:id="@+id/focusRing"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/focus_ring"
        android:visibility="gone" />

    <!-- On-screen brightness slider — appears beside the focus
         ring when the user taps; drag up for brighter, down for
         darker. Positioned in code, next to the tap. -->
    <com.hakunaa.app.scanner.ExposureSliderView
        android:id="@+id/exposureSlider"
        android:layout_width="36dp"
        android:layout_height="200dp"
        android:visibility="gone" />

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="Close"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="Flash"
            android:src="@drawable/ic_flash_off" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuto"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00000000"
            android:text="AUTO"
            android:textColor="#00BFA5"
            android:textStyle="bold"
            app:strokeColor="#00BFA5"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHd"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00000000"
            android:text="HD"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="1dp" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="More"
            android:src="@drawable/ic_more"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#000000"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Mode tabs — segmented pill. ALWAYS at the bottom,
             like professional scanners (CamScanner). (v0.1.57
             moved them to the top — the user said that was
             wrong; they belong at the bottom.) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/mode_tabs_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvModeSingle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Single"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvModeBatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Batch"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvModeBook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Book"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Capture row: the Spirit Level on the left (the
             bubble level, in the Grid button's place — the Grid
             itself is in the Settings panel now), the capture
             button in the middle, Import Images on the right.
             All Features is gone (it did nothing but a "coming
             soon" toast), Import Files is gone (it opened the
             same image picker as Import Images), and the scan
             filter is gone (unwanted — the filter is picked in
             Enhance, after the capture). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:id="@+id/btnLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="1.0"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Bullseye spirit level (v0.1.59): a round
                     bubble that moves left / right AND top /
                     bottom, so the phone can be levelled in
                     every direction. ON by default. Bigger
                     in v0.1.63 (56dp, was 44dp) — the user
                     asked for the Level circle to be a
                     little bigger. -->
                <com.hakunaa.app.scanner.SpiritLevelView
                    android:id="@+id/levelView"
                    android:layout_width="56dp"
                    android:layout_height="56dp" />

                <TextView
                    android:id="@+id/tvLevelLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Level"
                    android:textColor="#00BFA5"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Big round capture button, with the auto-capture
                 ring around it (fills smoothly while the page is
                 held steady; full means capture). -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center">

                <com.hakunaa.app.scanner.CaptureRingView
                    android:id="@+id/captureRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnCapture"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/capture_button"
                    android:contentDescription="Capture" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/btnImportImages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_import_image"
                    android:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Import Images"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Pages thumbnail + count (v0.1.74, Batch only):
                 once the first page is captured, Import Images
                 goes away and this takes its place — a small
                 thumbnail of the latest page with the pages
                 count, like CamScanner. Tapping it opens the
                 filters (Enhance) so the user can check them,
                 then comes back and keeps capturing. Hidden
                 until the first Batch capture (or in Single). -->
            <LinearLayout
                android:id="@+id/pagesThumbContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivPagesThumb"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="#FFFFFF"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tvPagesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="1 page"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Pages count + status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Point the camera at a document and tap Capture"
            android:textColor="#B0B0B0"
            android:textSize="13sp" />

        <!-- Export button (v0.1.94): back in the same place
             the Done button was — a big teal pill with bold
             white text and the page count, so no user has to
             guess what it does or where it is. (v0.1.57 made
             it compact because a big Save bar grew the bottom
             bar by 68dp and shrank the capture area — this one
             keeps its space reserved (invisible when empty),
             so the layout never shifts when a page is captured.)
             The label is "Export" now (user pick, v0.1.94),
             not "Done" — and the thumbnail tap does the same
             thing, so both ways go forward. Batch: opens the
             Filter (Enhance) screen. Single: goes straight
             to the export screen. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePdf"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:minWidth="180dp"
            android:text="Export"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#00BFA5"
            app:cornerRadius="24dp"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- Capture thumbnail (v0.1.74): after a capture, a small
         image of the page appears here (centre) and flies to
         the Done button, like a professional scanner. Hidden
         until a capture lands. White background so it reads as
         a page card. -->
    <ImageView
        android:id="@+id/ivCaptureThumb"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:background="#FFFFFF"
        android:scaleType="fitCenter"
        android:visibility="gone" />

</FrameLayout>
