<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-screen live camera preview — FIT_CENTER shows the
         whole camera frame (fillCenter cropped it, so the screen
         looked zoomed in). The preview uses the sensor's native
         4:3 aspect — the widest field of view, nothing cropped,
         no zoomed-in look. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <!-- Dynamic document-edge overlay — draws the detected page's
         real corners, live, right where the page is in the
         preview. No fixed box: the frame follows the book and
         disappears when no document is found. -->
    <com.hakunaa.app.scanner.EdgeOverlayView
        android:id="@+id/edgeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Rule-of-thirds grid — the framing aid, toggled from
         the Grid button on the bottom row. Off by default. -->
    <com.hakunaa.app.scanner.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Tap-to-focus ring — appears at the tap point, fades.
         Positioned in code, centred on the tap. -->
    <ImageView
        android:id="@+id/focusRing"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/focus_ring"
        android:visibility="gone" />

    <!-- On-screen brightness slider — appears beside the focus
         ring when the user taps; drag up for brighter, down for
         darker. Positioned in code, next to the tap. -->
    <com.hakunaa.app.scanner.ExposureSliderView
        android:id="@+id/exposureSlider"
        android:layout_width="36dp"
        android:layout_height="200dp"
        android:visibility="gone" />

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="Close"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="Flash"
            android:src="@drawable/ic_flash_off" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuto"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00000000"
            android:text="AUTO"
            android:textColor="#00BFA5"
            android:textStyle="bold"
            app:strokeColor="#00BFA5"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHd"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00000000"
            android:text="HD"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="1dp" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="More"
            android:src="@drawable/ic_more"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Mode tabs — moved to the TOP black space (v0.1.57).
         The 4:3 preview is letterboxed on a tall phone, so
         there is a wide empty band above it; the tabs live
         there now (below the top bar) instead of in the bottom
         bar. That keeps the bottom bar short, the capture area
         large, and uses the top space instead of wasting it. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:background="@drawable/mode_tabs_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvModeSingle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/mode_tab_selected"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Single"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvModeBatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Batch"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvModeBook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Book"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#000000"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Capture row: the Spirit Level on the left (the
             bubble level, in the Grid button's place — the Grid
             itself is in the Settings panel now), the capture
             button in the middle, Import Images on the right.
             All Features is gone (it did nothing but a "coming
             soon" toast), Import Files is gone (it opened the
             same image picker as Import Images), and the scan
             filter is gone (unwanted — the filter is picked in
             Enhance, after the capture). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:id="@+id/btnLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.4"
                android:gravity="center"
                android:orientation="vertical">

                <com.hakunaa.app.scanner.SpiritLevelView
                    android:id="@+id/levelView"
                    android:layout_width="88dp"
                    android:layout_height="20dp" />

                <TextView
                    android:id="@+id/tvLevelLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Level"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Big round capture button, with the auto-capture
                 ring around it (fills smoothly while the page is
                 held steady; full means capture). -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center">

                <com.hakunaa.app.scanner.CaptureRingView
                    android:id="@+id/captureRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnCapture"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/capture_button"
                    android:contentDescription="Capture" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/btnImportImages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_import_image"
                    android:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Import Images"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Pages count + status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Point the camera at a document and tap Capture"
            android:textColor="#B0B0B0"
            android:textSize="13sp" />

        <!-- Pages count + finish — ONE compact button, NOT a big
             full-width Save bar. (v0.1.57: the big Save button
             made the bottom bar grow by 68dp after the first
             capture, shrinking the capture area and pushing the
             detection frame's edges off-screen. The compact
             button keeps the capture area large and stable: its
             space is reserved (invisible when empty), so the
             layout never shifts when a page is captured.)
             Batch: opens the Pages screen to review + save.
             Single: goes straight to the export screen. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePdf"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="Done"
            android:visibility="invisible" />
    </LinearLayout>

</FrameLayout>
