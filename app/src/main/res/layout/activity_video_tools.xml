<?xml version="1.0" encoding="utf-8"?>
<!-- Video Tools menu (v0.1.159): single screen, NO scroll. The 10 tool
     cards are built in code into contentArea — 5 rows x 2 cols, ALL the
     same size, sharing the real screen height by weight. Lite pink
     cards (#FCE4EC) + pink border, premium gradient-square icons.
     No file-pick control at the top: each tool opens its own file
     picker when tapped, like PDF Tools. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hakunaa_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hakunaa_surface"
        android:elevation="2dp"
        android:title="Video Tools"
        android:titleTextColor="@color/hakunaa_text"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />
</LinearLayout>
