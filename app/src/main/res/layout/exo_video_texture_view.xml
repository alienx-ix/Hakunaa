<?xml version="1.0" encoding="utf-8"?>
<!-- Rotate preview ONLY (user 2026-11-28): the Rotate tool rotates
     the preview view (preview.rotation). A SurfaceView does NOT
     follow View rotation, so the preview never matches the output.
     A TextureView IS a normal View, so it rotates with the view.
     Media3 1.4.1 PlayerView has NO public setVideoSurfaceType —
     the surface type can only be set via this XML attribute, so
     the Rotate preview inflates this layout instead of building
     a PlayerView in code. Every other preview keeps the default
     SurfaceView (unchanged). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
