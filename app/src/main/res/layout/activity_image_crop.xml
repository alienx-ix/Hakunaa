<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Top bar: X (cancel) | title | Restore | ✓ (save) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Cancel"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvCropTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Crop"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <!-- Restore sits CENTRED in the top bar (weight 1 fills the middle),
             well away from the ✓ at the far right, so the two can never be
             mistouched. X stays left, ✓ stays far right. -->
        <TextView
            android:id="@+id/btnRestore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="24dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Restore"
            android:textColor="#00BFA5"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Save"
            android:src="@drawable/ic_check"
            android:tint="#00BFA5" />
    </LinearLayout>

    <com.hakunaa.app.image.ProCropView
        android:id="@+id/cropView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Live crop dimensions, e.g. "2788 × 2092" -->
    <TextView
        android:id="@+id/tvDimensions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- Rotation: angle label above the slider, 0° reset at the right -->
    <TextView
        android:id="@+id/tvAngle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:text="0°"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <SeekBar
            android:id="@+id/sbRotation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="90"
            android:progress="45" />

        <TextView
            android:id="@+id/btnRotateReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="0°"
            android:textColor="#00BFA5"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Aspect-ratio chips (hidden in DP Circle mode) -->
    <HorizontalScrollView
        android:id="@+id/aspectScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/aspectRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="Drag the corners to frame the part to keep"
        android:textColor="#B0B0B0"
        android:textSize="13sp" />
</LinearLayout>
