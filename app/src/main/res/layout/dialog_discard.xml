<?xml version="1.0" encoding="utf-8"?>
<!-- Discard confirmation (v0.1.67, CamScanner-style): a centred white
     card — "Note" title, message, Cancel (grey) / Discard (teal).
     Used by the export screen when the user presses Cancel or back:
     Single page -> "Are you sure to discard this image?", batch ->
     "Are you sure to discard all N pages?" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_white_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDiscardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Note"
        android:textColor="#212121"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvDiscardMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Are you sure to discard this image?"
        android:textColor="#616161"
        android:textSize="15sp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiscardCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#212121"
            android:textSize="15sp"
            app:backgroundTint="#EEEEEE"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiscardConfirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Discard"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:backgroundTint="#00BFA5"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
