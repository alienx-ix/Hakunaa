<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Top bar: back + editable document name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF" />

        <EditText
            android:id="@+id/etDocName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <!-- Page indicator — "2 / 4" when a batch has several
             pages; the user swipes the page to move between
             them. Hidden for a single page. -->
        <TextView
            android:id="@+id/tvPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Compare"
            android:textColor="#B0B0B0"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Page preview (v0.1.83: the top margin is 8dp, not
         32dp — the preview sits higher, closer to the top
         bar, so the space above it is small and the space
         below is used by the filter strip + bottom bar).
         The page lives in a frame with the Draw overlay and
         the placed signature / text on top of it. -->
    <FrameLayout
        android:id="@+id/pageFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/ivPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <!-- Draw overlay — visible whenever the page has a
             drawing (v0.1.83 fix: it used to hide on Done, so
             the drawing vanished from the screen). It only
             takes touches while drawing / erasing; otherwise
             swipes and zooms reach the page below. -->
        <com.hakunaa.app.scanner.DrawView
            android:id="@+id/drawView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Placed signature — draggable when present. -->
        <ImageView
            android:id="@+id/ivSignature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Placed text — a Word-style text box (v0.1.85):
             a teal border around the text, an X on top to
             delete it, and a resize handle at the bottom-right
             to make it bigger or smaller. Drag the box to move
             it; drag the handle to resize it.
             clipChildren=false (v0.1.88): the X and the handle
             sit OUTSIDE the box, so they must be allowed to
             draw past the box's edge — otherwise the box cuts
             them off and they are invisible. -->
        <FrameLayout
            android:id="@+id/textBoxContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_text_box"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivTextOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Delete — the X on top of the text box.
                 Big and teal (v0.1.86), so it is clearly
                 visible while editing. It sits OUTSIDE the
                 box (v0.1.87), so it is easy to grab. -->
            <TextView
                android:id="@+id/btnTextDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-26dp"
                android:layout_marginEnd="-26dp"
                android:background="@drawable/bg_text_delete_teal"
                android:gravity="center"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Resize — the handle at the bottom-right corner.
                 Drag it to make the text bigger or smaller.
                 It sits OUTSIDE the box (v0.1.87), so it is
                 easy to grab. -->
            <TextView
                android:id="@+id/btnTextResize"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="-26dp"
                android:layout_marginEnd="-26dp"
                android:background="@drawable/bg_text_delete_teal"
                android:gravity="center"
                android:text="⤢"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>

    <!-- Filter thumbnails -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/filterRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </HorizontalScrollView>

    <!-- Adjust panel — hidden until the Adjust menu button in
         the bottom bar is pressed. It NEVER opens on its own
         after a capture. Brightness / Contrast / Sharpness,
         applied on top of the chosen filter. -->
    <LinearLayout
        android:id="@+id/adjustPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adjust"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnAdjustReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Reset"
                android:textColor="#00BFA5"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnAdjustClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="✕"
                android:textColor="#B0B0B0"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="Brightness"
                android:textColor="#B0B0B0"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekBrightness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100"
                android:progressTint="#00BFA5"
                android:thumbTint="#00BFA5" />

            <TextView
                android:id="@+id/tvBrightnessValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="Contrast"
                android:textColor="#B0B0B0"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekContrast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="150"
                android:progress="50"
                android:progressTint="#00BFA5"
                android:thumbTint="#00BFA5" />

            <TextView
                android:id="@+id/tvContrastValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="1.00"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="Sharpness"
                android:textColor="#B0B0B0"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekSharpness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="40"
                android:progressTint="#00BFA5"
                android:thumbTint="#00BFA5" />

            <TextView
                android:id="@+id/tvSharpnessValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="40"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Apply to all pages — only when this batch already has
         other pages; the chosen filter + adjustments are then
         applied to every page on save. -->
    <LinearLayout
        android:id="@+id/applyAllRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/cbApplyAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/checkbox_apply_all"
            android:text="Apply to all pages"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvApplyAllCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="#808080"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Draw panel — only in Draw / Erase mode: pen colours,
         size, Undo, Clear, Done. The colour dots are built
         in code (setupDrawPanel). (v0.1.85: the panel was too
         wide — the dots + buttons added up past the screen, so
         Clear and Done hid off the right edge. Now the dots
         are smaller, the padding is tighter, and everything
         sits a little inside the edge.) -->
    <LinearLayout
        android:id="@+id/drawPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/colorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/btnDrawSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:text="Size: M"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDrawUndo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Undo"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnDrawClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Clear"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnDrawDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Done"
            android:textColor="#00BFA5"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sign panel — only while a signature is placed: drag
         it to move it, Remove takes it off, Done hides this
         row (the signature stays on the page). -->
    <LinearLayout
        android:id="@+id/signPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Drag the signature to move it"
            android:textColor="#B0B0B0"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSignRemove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Remove"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSignDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Done"
            android:textColor="#00BFA5"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Text panel — only while a text is placed: drag it
         to move it, Remove takes it off, Done hides this row
         (the text stays on the page). -->
    <LinearLayout
        android:id="@+id/textPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Drag the text to move it"
            android:textColor="#B0B0B0"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnTextRemove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Remove"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnTextDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Done"
            android:textColor="#00BFA5"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom bar (v0.1.84): Rotate / Crop / Adjust / Draw /
         Erase / Text / Sign + confirm, in that order. The
         seven tools SHARE the width evenly (each one
         layout_weight 1), so there is no big empty gap between
         them and the confirm button — the whole bar is used,
         and every tool is the same proper size (28dp icons,
         11sp labels). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Rotate — turns the page 90 degrees (the old
             "Left" button, renamed v0.1.82). -->
        <LinearLayout
            android:id="@+id/btnRotate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_rotate_left"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Rotate"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Crop — re-crop the current page from the Filter
             section (v0.1.58). It takes the place of Extract
             Text in the bottom menu: Extract Text (OCR) is a
             cloud feature, not possible offline, so it was only
             a greyed-out label; Crop is a real, working tool
             here. Opens the Crop screen for this page, where
             the corners can be dragged by hand. -->
        <LinearLayout
            android:id="@+id/btnCrop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_crop"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Crop"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Adjust — the menu button for the Adjust panel
             (Brightness / Contrast / Sharpness). The panel opens
             ONLY from here, never on its own after a capture. -->
        <LinearLayout
            android:id="@+id/btnAdjust"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivAdjustIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_tune"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvAdjustLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Adjust"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Draw — freehand markup on the page (v0.1.82):
             pen colours + sizes, Undo, Clear. The drawing
             stays visible on the page after Done and is saved
             onto the page. -->
        <LinearLayout
            android:id="@+id/btnDraw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivDrawIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_markup"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvDrawLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Draw"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Erase — rubs out drawn strokes (v0.1.83): touch
             a stroke to delete it. -->
        <LinearLayout
            android:id="@+id/btnErase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivEraseIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_eraser"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvEraseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Erase"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Text — type text and place it on the page
             (v0.1.83): a dialog takes the words, size and
             colour, then the text can be dragged to where it
             belongs. It is saved onto the page. -->
        <LinearLayout
            android:id="@+id/btnText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTextIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_text"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvTextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Text"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Sign — draw a signature and place it on the page
             (v0.1.82): a signature pad opens, then the
             signature can be dragged to where it belongs.
             It is saved onto the page. -->
        <LinearLayout
            android:id="@+id/btnSign"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivSignIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_sign"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvSignLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Sign"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Confirm — symbol only, no text (user pick):
             a big round teal button (56dp). Finish shows a
             tick, Continue shows a right arrow (the icon is
             set in code from EXTRA_CONFIRM_LABEL). It sits
             at the end of the bar, right after the tools —
             no big gap, the bar is used evenly. -->
        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_teal_button"
            android:contentDescription="Save"
            android:src="@drawable/ic_check"
            android:tint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
