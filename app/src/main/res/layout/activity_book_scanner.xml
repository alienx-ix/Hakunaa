<?xml version="1.0" encoding="utf-8"?>
<!-- Book Scan — landscape. The phone is held sideways so both
     pages of an open book fit side by side; the dashed spine
     line splits them into A (left) and B (right).
     Two narrow control strips leave the preview filling the
     whole screen — no top/bottom bars squeezing it, and
     nothing overlaps the status bar.
       LEFT strip — the file actions: Close, then Pages (with
       the count) and Save PDF at the bottom.
       RIGHT strip — the shooting actions: Torch as a proper
       round button, Single / Double as real segmented
       buttons, then the big capture button at the centre. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <!-- Draggable dashed spine line + A / B page labels. -->
    <com.hakunaa.app.scanner.SpineLineView
        android:id="@+id/spineLine"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Status line — overlaid at the bottom of the preview,
         so it never covers the book or squeezes the screen. -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="Point the camera at an open book — both pages at once"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- LEFT strip — file actions. -->
    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="Close"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPages"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Pages (0)"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePdf"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Save PDF"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- RIGHT strip — shooting actions. -->
    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnTorch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="Torch"
            android:src="@drawable/ic_flash_off" />

        <!-- Single / Double — real segmented buttons now: the
             selected one is a teal pill, the other is plain.
             Double captures both pages at once (A then B),
             Single captures one tapped page. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/mode_tabs_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvSingle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Single"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDouble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/mode_tab_selected"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Double"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Big round capture button, centred on the right. -->
        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/capture_button"
            android:contentDescription="Capture" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

</FrameLayout>
