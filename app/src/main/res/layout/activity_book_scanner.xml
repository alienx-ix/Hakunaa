<?xml version="1.0" encoding="utf-8"?>
<!-- Book Scan — landscape. The phone is held sideways so both
     pages of an open book fit side by side; the dashed spine
     line splits them into A (left) and B (right).
     Two narrow control strips leave the preview filling the
     whole screen — no top/bottom bars squeezing it, and
     nothing overlaps the status bar.
       LEFT strip — Close at the top, the Single / Double
       toggle in the middle, Pages (with the count) and Save
       PDF at the bottom.
       RIGHT strip — the shooting actions: Torch at the top,
       the big capture button at the centre. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <!-- Draggable dashed spine line + A / B page labels. -->
    <com.hakunaa.app.scanner.SpineLineView
        android:id="@+id/spineLine"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Capture thumbnail (v0.1.73): after a capture, a small
         image of the page appears here (centre) and flies to
         the Pages button, like a professional scanner. Hidden
         until a capture lands. White background so it reads as
         a page card. -->
    <ImageView
        android:id="@+id/ivCaptureThumb"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:background="#FFFFFF"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- Status line — overlaid at the bottom of the preview,
         so it never covers the book or squeezes the screen. -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="Point the camera at an open book — both pages at once"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- Single / Double (v0.1.101) — exactly like the
         CamScanner screenshot: a HORIZONTAL pill at the bottom
         centre of the preview, dark outer pill, the selected
         mode a grey pill (bold white text), the other plain.
         Double captures both pages at once (A then B), Single
         captures one tapped page. Sits above the status line. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="52dp"
        android:background="@drawable/mode_tabs_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvSingle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Single"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvDouble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/mode_single_double_selected"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Double"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- LEFT strip — file actions: Close at the top, Pages
         (with the count) and Save PDF at the bottom. (The
         Single / Double toggle moved to the bottom centre of
         the preview in v0.1.101, exactly like the CamScanner
         screenshot — a horizontal pill, not a vertical stack.) -->
    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="Close"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Latest page thumbnail (v0.1.74): a small image of
             the most recent capture, beside the Pages count —
             like CamScanner, not just a number changing.
             Hidden until the first page is captured. Tapping
             it opens Pages, like the Pages button. -->
        <ImageView
            android:id="@+id/ivLastPageThumb"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPages"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Pages (0)"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePdf"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Save PDF"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- RIGHT strip — shooting actions: Torch at the top, the
         big capture button centred. (Single / Double moved to
         the left strip — better placement, less cramped.) -->
    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnTorch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="Torch"
            android:src="@drawable/ic_flash_off" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Big round capture button, centred on the right. -->
        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/capture_button"
            android:contentDescription="Capture" />

        <!-- Spirit Level (v0.1.101): the 2D bullseye, below the
             capture button in the right strip. Display-only —
             it shows the phone's tilt live, always on, so the
             user holds the book level. -->
        <com.hakunaa.app.scanner.SpiritLevelView
            android:id="@+id/levelView"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

</FrameLayout>
