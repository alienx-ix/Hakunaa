<?xml version="1.0" encoding="utf-8"?>
<!-- Book Scan — landscape. The phone is held sideways so both
     pages of an open book fit side by side; the dashed spine
     line splits them into A (left) and B (right).
     v0.1.102: the preview runs TRULY edge-to-edge behind the
     status bar (StatusBar.setup with applyInsets=false) — no
     black band at the top, a bigger capture area. The buttons
     place themselves below the bar with explicit margins.
       Back arrow — top-LEFT corner, over the preview, just
       below the status bar (like CamScanner's X).
       LEFT strip — the Single / Double toggle in the middle,
       Pages (with the count) and Save PDF at the bottom.
       RIGHT strip — Torch at the top, the big capture button
       at the TRUE vertical centre (RelativeLayout, not a
       spacer pair that pushed it below centre). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <!-- Draggable dashed spine line + A / B page labels. -->
    <com.hakunaa.app.scanner.SpineLineView
        android:id="@+id/spineLine"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Capture thumbnail (v0.1.73): after a capture, a small
         image of the page appears here (centre) and flies to
         the Pages button, like a professional scanner. Hidden
         until a capture lands. White background so it reads as
         a page card. -->
    <ImageView
        android:id="@+id/ivCaptureThumb"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:background="#FFFFFF"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- Spirit Level (v0.1.102) — EXACTLY like Single/Batch:
         the 2D bullseye, 56dp, right next to the Capture
         button at the same height, live. In Single/Batch the
         Level sits left of Capture in the bottom row; here the
         capture column is the right strip, so the Level floats
         over the preview just left of the strip (152dp = the
         140dp strip + a 12dp gap), vertically centred with
         Capture. Display-only, always on. -->
    <com.hakunaa.app.scanner.SpiritLevelView
        android:id="@+id/levelView"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="152dp" />

    <!-- LEFT strip — file actions + the Single / Double
         toggle in the middle. (Close moved to the top-left
         corner in v0.1.102.) -->
    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="12dp">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.3" />

        <!-- Single / Double (v0.1.104) — sits a little LOWER
             now (top spacer 1.3, bottom spacer 0.7), and the
             selected mode is a professional GREY pill (like
             the pro scanner apps), not a bright teal block.
             Double captures both pages at once (A then B),
             Single captures one tapped page. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/mode_tabs_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvSingle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Single"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDouble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/mode_tab_selected"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Double"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.7" />

        <!-- Latest page thumbnail (v0.1.74): a small image of
             the most recent capture, beside the Pages count —
             like CamScanner, not just a number changing.
             Hidden until the first page is captured. Tapping
             it shows the last capture full-screen (v0.1.104). -->
        <ImageView
            android:id="@+id/ivLastPageThumb"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPages"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Pages (0)"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePdf"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Save PDF"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- RIGHT strip (v0.1.102) — RelativeLayout now: Torch
         pinned to the top, the big capture button at the TRUE
         vertical centre (centerInParent). The old LinearLayout
         with two equal spacers pushed Capture below centre,
         because the Torch took space at the top.
         v0.1.104: an Exit button sits below Capture — Book's
         own way out, right where the shooting hand is, so
         leaving does not mean hunting for the corner arrow. -->
    <RelativeLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:clickable="true"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnTorch"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="36dp"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="Torch"
            android:src="@drawable/ic_flash_off" />

        <!-- Big round capture button, at the true centre. -->
        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_centerInParent="true"
            android:background="@drawable/capture_button"
            android:contentDescription="Capture" />

        <!-- Exit (v0.1.105) — at the BOTTOM of the right
             strip, level with the Save PDF button on the left
             strip, so the shooting hand reaches it without
             stretching. alignParentBottom puts it at the
             strip's bottom (the 12dp padding insets it
             exactly like Save PDF on the left). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExit"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:text="Exit"
            android:textSize="14sp" />
    </RelativeLayout>

    <!-- Back arrow (v0.1.102) — top-LEFT corner, over the
         preview. v0.1.108: BIGGER (56dp, was 48dp) and
         HIGHER (marginTop 12dp, was 20dp) — the status bar
         is hidden now, so the arrow sits in the true top
         corner. v0.1.104: it MUST be the LAST child in this
         file. The left strip is clickable and covers the
         corner, so when the arrow sat before the strips the
         strip ate every tap and the back button did nothing.
         Last child = topmost = receives the tap. -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/circle_button_bg"
        android:contentDescription="Close"
        android:src="@drawable/ic_arrow_back"
        android:tint="#FFFFFF" />

</FrameLayout>
