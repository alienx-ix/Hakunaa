<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hakunaa_background"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Close"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:tint="@color/hakunaa_text" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Compress"
            android:textColor="@color/hakunaa_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Image header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:background="@color/hakunaa_outline" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvImageName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/hakunaa_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvImageInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/hakunaa_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Content — NOT a ScrollView (v0.1.125): NOTHING scrolls.
         The content area fills the remaining height (weight 1);
         each screen's cards share that height by weight, so every
         screen fits ONE screen on any phone — no cut-off, no gap.
         (v0.1.124 put the same weight-1 containers inside a
         ScrollView, where weights never expand — that is why the
         Compress rows left a gap and Convert/Social still scrolled.) -->
    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/hakunaa_text_secondary"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rgOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/resultsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/targetSizeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etTargetSize"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_search"
                    android:hint="Enter size (e.g. 500)"
                    android:inputType="numberDecimal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/unitContainer"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_search"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvUnitKb"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_teal_button"
                        android:gravity="center"
                        android:text="KB"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUnitMb"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="MB"
                        android:textColor="@color/hakunaa_text_secondary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Compress mode cards (Quality / Target / HD): fill the
                 remaining screen height (v0.1.122) — the 3 cards share
                 the space, so the screen looks full, no empty gap. -->
            <LinearLayout
                android:id="@+id/modeContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/qualityContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/metadataContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />
    </LinearLayout>

    <!-- v0.1.131 (Batch 15): these two lines are GONE by default.
         They had no visibility attribute, so they were VISIBLE
         with empty text — ~54dp of invisible dead space (~35dp
         status + ~19dp result) that sat between the content and
         the bottom bar on every screen where no status was ever
         set (Compress mode, Convert), leaving a big empty gap
         above Back. setStatusText / setResultText already toggle
         visibility whenever text is set, so a real status still
         shows. Removing the dead space also gives the Compress
         photo and the Convert cards more room, so they fill the
         screen (Convert's boxes get a little bigger). -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text=""
        android:textColor="@color/hakunaa_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textColor="@color/hakunaa_success"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- "Save selected" — pinned just above the bottom bar on
         result screens (v0.1.124), NOT inside the scrolling list,
         so it never goes into scroll (v0.1.123 left it below the
         fold with 5 results). -->
    <LinearLayout
        android:id="@+id/saveBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <!-- "Better Compress with WebP" — pinned just above the
         bottom bar on result screens (v0.1.123), NOT inside the
         scrolling results list, so the list stays light and the
         button is always right above Back / Done. -->
    <LinearLayout
        android:id="@+id/betterCompressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <!-- Bottom bar: Back / Next — matching theme buttons, same
         size and shape (v0.1.121 fix: Back was a plain TextView
         and looked nothing like Next). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Back"
            android:textColor="@color/hakunaa_teal"
            app:backgroundTint="@color/hakunaa_surface"
            app:cornerRadius="12dp"
            app:strokeColor="@color/hakunaa_teal"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Next"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/hakunaa_teal"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
