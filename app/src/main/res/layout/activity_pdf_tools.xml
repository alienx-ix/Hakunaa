<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hakunaa_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/card_pdf_title"
            android:textColor="@color/hakunaa_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Merge, split, compress, rotate, watermark, page numbers, organize and extract — all on-device."
            android:textColor="@color/hakunaa_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickPdfs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pick_pdfs" />

        <TextView
            android:id="@+id/tvFiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ready"
            android:textColor="@color/hakunaa_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMerge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/merge_pdfs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSplit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Split PDF — one file per page" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompressPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Compress PDF — lossless" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompressSmart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Compress PDF — smart (smaller)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImageToPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Image to PDF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Rotate"
            android:textColor="@color/hakunaa_text"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgRotate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbRotate90"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="90°" />

            <RadioButton
                android:id="@+id/rbRotate180"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="180°" />

            <RadioButton
                android:id="@+id/rbRotate270"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="270°" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRotate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Rotate PDF" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etWatermark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Watermark text (e.g. CONFIDENTIAL)"
            android:inputType="text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWatermark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Add Watermark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPageNumbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Add Page Numbers" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Pages, e.g. 1,3,5-7"
            android:inputType="text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeletePages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Delete Pages" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExtractPages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Extract Pages to new PDF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExtractImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Extract Images" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ready"
            android:textColor="@color/hakunaa_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Split and Compress use the first selected PDF. Smart Compress downscales images to 150 DPI, JPEG 82% — 60–70% smaller, eye cannot tell."
            android:textColor="@color/hakunaa_text_secondary" />
    </LinearLayout>
</ScrollView>
