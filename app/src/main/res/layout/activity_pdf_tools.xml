<?xml version="1.0" encoding="utf-8"?>
<!-- PDF Tools menu (v0.1.149): single screen, NO scroll. The 16 tool
     cards are built in code into contentArea — 2 featured rows (weight
     1.25) + 4 grid rows (weight 1) share the real screen height.
     No file-pick control at the top (v0.1.149): each tool opens its
     own file picker when tapped, like Image Tools. No status line
     at the bottom either — results come via Toast / Saved dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hakunaa_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hakunaa_surface"
        android:elevation="2dp"
        android:title="PDF Tools"
        android:titleTextColor="@color/hakunaa_text"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp" />
</LinearLayout>
