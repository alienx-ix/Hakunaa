<?xml version="1.0" encoding="utf-8"?>
<!-- Capture resolution picker (v0.1.63, professional
     bottom sheet — CamScanner-style): the sheet slides up
     from the bottom edge, full width, rounded top corners.
     Title + a list of clean rows (built in code from what
     this phone's camera really supports) + a Hide button
     at the bottom, the way CamScanner does it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bottom_sheet_bg"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="16dp">

    <!-- Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Capture resolution"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseResolution"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Rows — built in code (the phone's real sizes). -->
    <LinearLayout
        android:id="@+id/resolutionRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <!-- Hide — CamScanner's bottom dismiss. -->
    <TextView
        android:id="@+id/tvHideResolution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:paddingBottom="8dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:text="Hide  ^"
        android:textColor="#9A9A9A"
        android:textSize="15sp" />
</LinearLayout>
