<?xml version="1.0" encoding="utf-8"?>
<!-- Tap-to-focus ring: a teal circle outline drawn at the point
     the user tapped on the preview. Shown briefly, then fades. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <stroke
        android:width="2dp"
        android:color="#00BFA5" />
    <solid android:color="#00000000" />
</shape>
