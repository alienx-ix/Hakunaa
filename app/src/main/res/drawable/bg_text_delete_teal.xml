<?xml version="1.0" encoding="utf-8"?>
<!-- A round teal button with a white symbol — the delete
     (X) and resize (⤢) buttons on a placed text box. Teal,
     so they stand out clearly on the page while editing. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#00BFA5" />
    <stroke
        android:width="1.5dp"
        android:color="#FFFFFF" />
</shape>
