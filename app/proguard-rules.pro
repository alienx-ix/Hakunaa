# Hakunaa R8 (shrinker) rules for the manual build.
# Debug build: shrink unused classes (the 16 MB unshrunk DEX is the
# prime suspect for the black-screen freeze — first-launch DEX
# verification takes far too long), but do NOT obfuscate or optimise,
# so stack traces stay readable and behaviour stays predictable.
-dontobfuscate
-dontoptimize
-dontwarn **
-ignorewarnings

-keepattributes *Annotation*, Signature, Exceptions, InnerClasses, EnclosingMethod

# R classes — referenced by libraries at runtime (AppCompat's
# AppCompatDrawableManager needs androidx.appcompat.R$drawable at
# startup). The R.java files are generated by aapt2 into out/gen
# and MUST be compiled into the DEX; a stale classes.done marker
# once skipped that compile, so the R classes were never in the
# DEX at all (not an R8 removal). Keep every library's R class
# and its inner $attr/$drawable/$style/... classes, and their
# fields (the canonical AGP rule).
-keep class **.R { *; }
-keep class **.R$* { *; }
-keepclassmembers class **.R$* {
    public static <fields>;
}

# AppCompat itself (the app's Activities are AppCompat-based; keep
# the whole library so no internal helper it needs is ever removed).
-keep class androidx.appcompat.** { *; }

# Views referenced from layout XML (R8 cannot see XML references —
# it removed MaterialCardView and the home screen would crash on
# launch). Keep the whole Material package; it is small.
-keep class com.google.android.material.** { *; }

# CameraX — PreviewView is referenced from activity_scanner.xml
# (R8 cannot see XML references, so it removed PreviewView and the
# scanner crashed on launch with ClassNotFoundException). Keep the
# whole CameraX package; the preview, capture and lifecycle
# classes are all needed at runtime.
-keep class androidx.camera.** { *; }

# AndroidX Core widgets — Material's dialog layout
# (m3_alert_dialog) references androidx.core.widget
# .NestedScrollView from XML. R8 cannot see XML references, so
# it removed NestedScrollView and the export dialog crashed on
# inflate (v0.1.38: "Error inflating class androidx.core.widget
# .NestedScrollView"). Same class of bug as PreviewView.
# Keep the whole widget package; it is small.
-keep class androidx.core.widget.** { *; }
# RecyclerView — the Pages screen's list is referenced from
# activity_pages.xml. R8 cannot see XML references, so it
# removed RecyclerView's (Context, AttributeSet) constructor
# and opening Pages crashed with NoSuchMethodException on
# inflate (v0.1.43: "Error inflating class
# androidx.recyclerview.widget.RecyclerView"). Same class of
# bug as PreviewView and NestedScrollView.
-keep class androidx.recyclerview.widget.** { *; }


# The app's own code — all of it.
-keep class com.hakunaa.app.** { *; }

# FFmpegKit Java API + JNI bridge (native methods).
-keep class com.arthenica.ffmpegkit.** { *; }
-keep class com.arthenica.smart-exception.** { *; }

# PDFBox-Android (uses reflection internally).
-keep class com.tom_roush.pdfbox.** { *; }
-keep class org.apache.pdfbox.** { *; }

# BouncyCastle (PDFBox crypto; only loaded for encrypted PDFs,
# but keep it so PDF tools never break at runtime).
-keep class org.bouncycastle.** { *; }

# Native methods must never be renamed/removed.
-keepclasseswithmembernames class * { native <methods>; }

# Kotlin metadata (reflection / serialization).
-keep class kotlin.Metadata { *; }

# AndroidX Startup (initializers are discovered via the manifest).
-keep class androidx.startup.** { *; }

# Anything referenced from AndroidManifest.xml.
-keep public class * extends android.app.Application
-keep public class * extends android.app.Activity
-keep public class * extends android.content.ContentProvider
-keep public class * extends android.content.BroadcastReceiver
-keep public class * extends android.app.Service
